#!/bin/sh
name=${0##*/}
case "$name" in
    aws-dev) profile=dev ;;
    aws-staging) profile=staging ;;
    aws-prod) profile=prod ;;
    aws-session)
        case "${1:-}" in
            -h|--help|'')
                printf '%s\n' 'Usage: aws-session <dev|staging|prod> [--legacy-default] [--] [command [arguments...]]'
                [ "$#" -gt 0 ] && exit 0
                exit 2
                ;;
        esac
        profile=$1
        shift
        ;;
    *) printf 'Unknown AWS helper: %s\n' "$name" >&2; exit 2 ;;
esac
if [ ! -r "$HOME/.config/ais/shell-env.sh" ]; then
    printf '%s\n' 'Missing AIS environment loader. Run the workspace installer first.' >&2
    exit 2
fi
. "$HOME/.config/ais/shell-env.sh"
exec python3 "$HOME/.config/ais/aws-session.py" "$profile" "$@"
