#!/usr/bin/env python3
"""Decode a JWT header and payload without verifying its signature."""
import argparse
import base64
import binascii
import json
import sys

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('token', nargs='?', help='JWT; omit to read from standard input')
args = parser.parse_args()
if args.token is None and sys.stdin.isatty():
    parser.error('supply a JWT or pipe it on standard input')
token = args.token if args.token is not None else sys.stdin.read().strip()
try:
    parts = token.split('.')
    if len(parts) not in (2, 3):
        raise ValueError('wrong JWT structure')
    decoded = [json.loads(base64.b64decode(part + '=' * (-len(part) % 4), altchars=b'-_', validate=True).decode()) for part in parts[:2]]
except (ValueError, UnicodeError, binascii.Error):
    parser.exit(2, 'Invalid JWT header or payload. The signature has not been verified.\n')
print(json.dumps(decoded, indent=2))
